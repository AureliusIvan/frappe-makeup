# =============================================================================
# Invenio Property Management - ERPNext Development Environment Configuration
# =============================================================================
#
# Copy this file to .env and update the values for your local development.
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (MariaDB)
# -----------------------------------------------------------------------------

# MariaDB root password
# Used for administrative tasks and database initialization
# REQUIRED: Change this to a secure password!
MYSQL_ROOT_PASSWORD=changeme_root_password

# MariaDB database name
MYSQL_DATABASE=erpnext

# MariaDB user for the application
MYSQL_USER=erpnext

# MariaDB user password
# REQUIRED: Change this to a secure password!
MYSQL_PASSWORD=changeme_db_password

# -----------------------------------------------------------------------------
# Frappe/ERPNext Configuration
# -----------------------------------------------------------------------------

# Frappe site name
# Default: localhost
# Change this if you want a different site name
SITE_NAME=localhost

# Administrator password for Frappe site
# This is the password for the 'Administrator' user
# REQUIRED: Change this to a secure password!
# Minimum 8 characters recommended
ADMIN_PASSWORD=changeme_admin_password

# Frappe framework version
# Default: v15.30.0
# See: https://github.com/frappe/frappe/releases
FRAPPE_VERSION=v15.30.0

# ERPNext version
# Default: version-15 (tracks latest v15.x)
# See: https://github.com/frappe/erpnext/releases
ERPNEXT_VERSION=version-15

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------

# Redis cache server
# Used for application caching
REDIS_CACHE=redis://redis-cache

# Redis queue server
# Used for background job processing
REDIS_QUEUE=redis://redis-queue

# Redis socketio server
# Used for real-time communications
REDIS_SOCKETIO=redis://redis-socketio

# -----------------------------------------------------------------------------
# Database Connection (for Frappe bench)
# -----------------------------------------------------------------------------

# Database host
# Default: mariadb (Docker service name)
DB_HOST=mariadb

# Database port
# Default: 3306 (standard MariaDB port)
DB_PORT=3306

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Enable developer mode
# Set to 1 to enable auto-reload, detailed errors, unminified JS/CSS
# Set to 0 for production
# Default: 1 (already set in docker-compose.yml)
# FRAPPE_DEVELOPER=1

# Socket.IO port
# Default: 9000
# SOCKETIO_PORT=9000

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------

# Backup directory (on host machine)
# Default: ./backups
BACKUP_DIR=./backups

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------

# Custom app name (if different from invenio_property_management)
# APP_NAME=invenio_property_management

# Enable pre-commit hooks
# ENABLE_PRECOMMIT=1

# -----------------------------------------------------------------------------
# Docker Configuration
# -----------------------------------------------------------------------------

# Host port to expose the application
# Default: 8000
# Change this if port 8000 is already in use
# HOST_PORT=8000

# Host port to expose MariaDB (if you want to access it directly)
# Uncomment the following line and add port mapping in docker-compose.yml
# DB_HOST_PORT=3306

# -----------------------------------------------------------------------------
# Security Notes
# -----------------------------------------------------------------------------
#
# 1. ALWAYS change the default passwords before use
# 2. Use strong passwords (16+ characters, mixed case, numbers, symbols)
# 3. Never commit .env to version control (.env is in .gitignore)
# 4. Rotate passwords regularly in production environments
# 5. Use different passwords for each environment (dev, staging, production)
# 6. Consider using a password manager to generate secure passwords
#
# Example of a strong password:
#   openssl rand -base64 32
#
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Quick Setup Commands
# -----------------------------------------------------------------------------
#
# After editing this file:
#   1. Copy to .env:           cp .env.example .env
#   2. Edit .env:              nano .env  (or your preferred editor)
#   3. Start containers:       make up
#   4. Run setup:              make dev-setup
#   5. Access application:     http://localhost:8000
#
# For more information, see README.md and DEVELOPMENT.md
# -----------------------------------------------------------------------------
